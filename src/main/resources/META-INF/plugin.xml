<idea-plugin>
    <id>com.base.idea.hyperf</id>
    <name>Hyperf Base</name>
    <vendor email="group@hyperf.io" url="https://www.hyperf.io">Hyperf Team</vendor>

    <description><![CDATA[
      Hyperf Base provides IDE support for the Hyperf PHP framework in PhpStorm, including route controller completion &amp; navigation, config key indexing, translation key indexing, environment variable completion, and validation rule completion &amp; hover docs.
      <br/>
      <a href="https://github.com/tw2066/idea-plugin-hyperf">Issues</a>
      <br/>

      <h2>功能特性</h2>
      <ul>
        <li><b>路由</b>：<code>Router::get/post/put/patch/delete/options/addRoute</code> 的控制器补全与跳转 —— 兼容 Hyperf 3.x 的 <code>@method</code> 魔术 Router 写法</li>
        <li><b>配置</b>：<code>config()</code> / <code>ConfigInterface::get/has</code> 配置键的索引、补全与跳转 —— 支持 Hyperf 3.1+ 的点号配置文件（<code>sub/a.php</code> → <code>sub.a</code>，<code>a.b.php</code> → <code>a.b</code>）</li>
        <li><b>翻译</b>：<code>trans()</code> / <code>__()</code> / <code>TranslatorInterface::trans()</code> 翻译键的索引、补全与跳转（需安装 hyperf/translation）</li>
        <li><b>环境变量</b>：<code>env()</code> 环境变量键的补全与跳转（读取项目根目录 <code>.env</code> 文件）</li>
        <li><b>验证规则</b>：验证规则字符串（<code>required|max:255</code>）的补全与悬停中文文档 —— 支持 <code>FormRequest::rules()</code>、<code>ValidatorFactory::make()/validate()</code> 规则数组、<code>$scenes</code> 值及 DTO 注解 <code>#[Validation(...)]</code>（需安装 hyperf/validation 或 hyperf/dto）</li>
      </ul>

      <h2>安装与设置</h2>
      <ul>
        <li>安装插件后，在 <b>Settings &gt; Languages &amp; Frameworks &gt; PHP &gt; Hyperf Base</b> 中按项目启用</li>
        <li>未使用默认目录结构时，可配置翻译目录</li>
      </ul>
    ]]></description>

    <extensions defaultExtensionNs="com.intellij">
        <projectConfigurable instance="com.base.idea.hyperf.ui.HyperfProjectSettingsForm"
                             id="hyperf.base.SettingsForm"
                             displayName="Hyperf Base"
                             parentId="reference.webide.settings.project.settings.php"
                             nonDefaultProject="true"
        />
        <completion.contributor language="any"
                                implementationClass="fr.adrienbrault.idea.symfony2plugin.codeInsight.completion.CompletionContributor"/>
        <gotoDeclarationHandler
                implementation="fr.adrienbrault.idea.symfony2plugin.codeInsight.navigation.GotoHandler"/>
        <lang.documentationProvider language="PHP"
                implementationClass="com.base.idea.hyperf.validation.ValidationDocumentationProvider"/>

        <projectService serviceImplementation="com.base.idea.hyperf.HyperfSettings"/>
        <fileBasedIndex implementation="com.base.idea.hyperf.stub.ConfigKeyStubIndex"/>
        <fileBasedIndex implementation="com.base.idea.hyperf.stub.TranslationKeyStubIndex"/>
        <fileBasedIndex implementation="com.base.idea.hyperf.stub.EnvKeyStubIndex"/>
        <postStartupActivity implementation="com.base.idea.hyperf.HyperfStartupActivity"/>
        <notificationGroup id="hyperf base" displayType="BALLOON"/>
    </extensions>

    <idea-version since-build="262"/>

    <depends>com.jetbrains.php</depends>
    <depends>com.intellij.modules.platform</depends>
</idea-plugin>
